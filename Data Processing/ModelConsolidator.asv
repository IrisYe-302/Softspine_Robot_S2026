%% Penetration Depth + Rotational Correction Combiner — runs all experiments in one shot
clear
clc

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Experiment Definitions
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
experiments = struct([]);

experiments(1).name           = "Main (June12, Rigid/Granular)";
experiments(1).data_mat       = "DataProcessing_results.mat";
experiments(1).quat_mat       = "QuaternionAngleAnalysis_June12_results.mat";
experiments(1).has_terrain    = true; % DataProcessing.m's results are indexed by terrain too

experiments(2).name           = "Pierre (Apr17, Sand)";
experiments(2).data_mat       = "PierreDataProcessing_results.mat";
experiments(2).quat_mat       = "QuaternionAngleAnalysis_Pierre_results.mat";
experiments(2).has_terrain    = false;

experiments(3).name           = "Sahil (July25, Sand)";
experiments(3).data_mat       = "SahilDataProcessing_results.mat";
experiments(3).quat_mat       = "QuaternionAngleAnalysis_Sahil_results.mat";
experiments(3).has_terrain    = false;
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

for e = 1:length(experiments)
    disp("=== " + experiments(e).name + " ===")
    run_combiner(experiments(e));
    disp(" ")
end

%% Local function — loads, computes phase-specific a, and displays actual vs. modeled
function run_combiner(cfg)

    data = load(cfg.data_mat);
    quat = load(cfg.quat_mat);

    Phase_String = data.Phase_String;
    nP = length(Phase_String);

    %% Compute rotational correction a per phase
    % Use the original theta values from the quaternion analysis
    % Con  -> a > 0
    % Des  -> a < 0
    % Other -> a = 0
    %
    % Geometry:
    %   (x + 4)*theta = 14
    %   9.5^2 = sqrt((x - x*cos(theta))^2 + (2.75 - x*sin(theta))^2)
    %   Lc = 2*(x + 10.2)*sin(theta/2)
    %   Ld = 2*(x + 4 - 6.2)*sin(theta/2)
    %   l  = 14

    a_phase = NaN(nP, 1);

    for i = 1:nP
        quat_idx = find(quat.Phase_String == Phase_String(i), 1, 'first');
        if isempty(quat_idx) || isnan(quat.avg_yaw_theta(quat_idx))
            continue
        end

        theta_deg = quat.avg_yaw_theta(quat_idx); % original theta from quaternion analysis
        theta = deg2rad(theta_deg);

        if abs(theta) < eps
            a_phase(i) = 0;
            continue
        end

        % Initial guess from (x + 4)*theta = 14
        x0 = 14/theta - 4;

        % Solve the second equation numerically for x
        f = @(x) sqrt((x - x*cos(theta)).^2 + (2.75 - x*sin(theta)).^2) - 9.5;

        x = NaN;
        try
            % Try to solve near the initial guess
            x = fzero(f, x0);
        catch
            % If fzero fails, try a couple of fallback guesses
            guesses = [x0, max(0.1, x0/2), x0*2, 10, 20, 30];
            for g = guesses
                try
                    x = fzero(f, g);
                    break
                catch
                end
            end
        end

        if isnan(x)
            disp("Warning: could not solve x for " + Phase_String(i) + " — leaving a as NaN")
            continue
        end

        Lc = 2*(x + 10.2)*sin(theta/2);
        Ld = 2*(x + 4 - 6.2)*sin(theta/2);
        l  = 14;

        switch lower(char(Phase_String(i)))
            case 'con'
                a_phase(i) = abs(l - Lc);   % positive
            case 'des'
                a_phase(i) = -abs(l - Ld);  % negative
            otherwise
                a_phase(i) = 0;
        end
    end

    %% Display actual vs. projected step length
    if cfg.has_terrain

        Terrain_String = data.Terrain_String;

        % Apply rotational correction by phase:
        % Con = s + a
        % Des = s + a   (with a negative)
        % Everything else = s
        s_plus_a_phase = data.s_phase;

        for i = 1:nP
            s_plus_a_phase(:,i) = data.s_phase(:,i) + a_phase(i);
        end

        disp('Actual vs. Modeled Step Length:')
        for k = 1:length(Terrain_String)
            disp("--- " + Terrain_String(k) + " ---")
            for i = 1:nP
                actual_str = "no data";
                if ~isnan(data.avg_step_per_phase_all(k,i))
                    actual_str = round(data.avg_step_per_phase_all(k,i)*100,2) + " ± " + round(data.std_step_per_phase_all(k,i)*100,2) + " cm";
                end

                a_val = 0;
                if ~isnan(a_phase(i))
                    a_val = a_phase(i);
                end

                modeled_str = "no data";
                if ~isnan(s_plus_a_phase(k,i))
                    modeled_str = round(s_plus_a_phase(k,i),2) + " cm (d=" + round(data.d_phase(k,i),2) + ", s=" + round(data.s_phase(k,i),2) + ", a=" + round(a_val,2) + ")";
                end

                disp(Phase_String(i) + ":  actual = " + actual_str + "   |   modeled = " + modeled_str)
            end
        end

    else

        % Apply rotational correction by phase:
        % Con = s + a
        % Des = s + a   (with a negative)
        % Everything else = s
        s_plus_a_phase = data.s_phase;

        for i = 1:nP
            s_plus_a_phase(i) = data.s_phase(i) + a_phase(i);
        end

        disp('Actual vs. Modeled Step Length:')
        for i = 1:nP
            actual_str = "no data";
            if ~isnan(data.avg_step_per_phase(i))
                actual_str = round(data.avg_step_per_phase(i)*100,2) + " ± " + round(data.std_step_per_phase(i)*100,2) + " cm";
            end

            a_val = 0;
            if ~isnan(a_phase(i))
                a_val = a_phase(i);
            end

            modeled_str = "no data";
            if ~isnan(s_plus_a_phase(i))
                modeled_str = round(s_plus_a_phase(i),2) + " cm (d=" + round(data.d_phase(i),2) + ", s=" + round(data.s_phase(i),2) + ", a=" + round(a_val,2) + ")";
            end

            disp(Phase_String(i) + ":  actual = " + actual_str + "   |   modeled = " + modeled_str)
        end
    end
end